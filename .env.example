# Copy to .env for local development. Ports match infra/docker-compose.yml.
NODE_ENV=development

# API
HOST=0.0.0.0
PORT=4000

# Postgres. The app connects as app_user (RLS enforced); migrations run as app_owner.
POSTGRES_PORT=5433
DATABASE_URL=postgres://app_user:app_user@localhost:5433/shiftora
MIGRATION_DATABASE_URL=postgres://app_owner:app_owner@localhost:5433/shiftora

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Mailpit catches all outgoing email locally: UI at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
