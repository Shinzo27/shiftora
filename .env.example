# Copy to .env for local development. Ports match infra/docker-compose.yml.
NODE_ENV=development
# JSON logs (pino) from the API and the worker: trace, debug, info, warn, error, silent.
LOG_LEVEL=info

# API
HOST=0.0.0.0
PORT=4000

# Postgres. The app connects as app_user (RLS enforced); migrations run as app_owner.
POSTGRES_PORT=5433
DATABASE_URL=postgres://app_user:app_user@localhost:5433/shiftora
MIGRATION_DATABASE_URL=postgres://app_owner:app_owner@localhost:5433/shiftora

# Auth. The JWT secret signs access tokens: at least 32 characters. Generate a real one with
#   openssl rand -base64 48
# The API refuses to start in production with a value starting with "dev-only".
JWT_ACCESS_SECRET=dev-only-change-me-0123456789abcdefghijklmnop
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Browser origin of the web app (CORS with credentials)
WEB_ORIGIN=http://localhost:5173

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Mailpit catches all outgoing email locally: UI at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025

# Web Push (VAPID). Generate a pair with `npx web-push generate-vapid-keys` and paste both.
# Leave them empty and the staff app hides its notification button — nothing else changes.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@shiftora.local

# WhatsApp and SMS providers: none (channel off, staff who chose it get email) or fake (logs
# instead of sending; the quota, retries, dead letters and replay all run). Meta comes next.
WHATSAPP_PROVIDER=fake
SMS_PROVIDER=fake
# Failure injection for the fake providers: none | transient | permanent | rate_limited |
# undeliverable (accepted, then reported failed a moment later through the webhook)
FAKE_PROVIDER_FAILURE=none

# WhatsApp delivery reports. Meta signs every webhook with the app secret (X-Hub-Signature-256);
# the API refuses anything else. Empty = the webhook answers 404. The verify token is what you
# type into Meta's dashboard when registering the URL. Locally any 16+ character value works:
#   openssl rand -hex 24
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# With the secret set, the fake WhatsApp provider posts signed reports (delivered, read, or
# failed for `undeliverable`) here, so the whole round trip runs without a Meta account.
FAKE_PROVIDER_REPORT_URL=http://localhost:4000/api/v1/webhooks/whatsapp

# Shift reminders (2 h before) and missed clock-ins (after the org's grace): scan interval.
ALERT_SCAN_INTERVAL_MS=60000
