{
  "name": "@shiftora/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas and API types shared by api, worker and web",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
