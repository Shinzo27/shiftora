{
  "name": "@shiftora/domain",
  "version": "0.0.0",
  "private": true,
  "description": "Pure business logic: validation, pay rules, scheduler, time utils",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "bench": "tsc -p tsconfig.build.json && node ../../scripts/bench-scheduler.mjs"
  },
  "devDependencies": {
    "@shiftora/config": "workspace:*",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  }
}
