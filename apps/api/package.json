{
  "name": "@shiftora/api",
  "version": "0.0.0",
  "private": true,
  "description": "Shiftora HTTP + WebSocket API (NestJS on Fastify)",
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/require-node.mjs",
    "dev": "nest start --watch",
    "build": "nest build",
    "seed": "node --env-file-if-exists=../../.env dist/cli/seed.js",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-fastify": "^12.3.2",
    "@nestjs/platform-socket.io": "^12.3.3",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.3.3",
    "@node-rs/argon2": "^2.2.2",
    "@shiftora/db": "workspace:*",
    "@shiftora/domain": "workspace:*",
    "@shiftora/shared": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "jose": "^6.2.13",
    "redis": "^6.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@shiftora/config": "workspace:*",
    "@swc/core": "^1.16.20",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "testcontainers": "12.2.1",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.12"
  }
}
