{
  "name": "shiftora",
  "private": true,
  "description": "Shift scheduling and attendance SaaS for small businesses",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "predev": "node scripts/require-node.mjs",
    "dev": "turbo run dev",
    "prebuild": "node scripts/require-node.mjs",
    "pretest": "node scripts/require-node.mjs",
    "pretest:int": "node scripts/require-node.mjs",
    "pretest:e2e": "node scripts/require-node.mjs",
    "predb:migrate": "node scripts/require-node.mjs",
    "predb:seed": "node scripts/require-node.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:generate": "pnpm --filter @shiftora/db generate",
    "db:seed": "turbo run build --filter=@shiftora/api && pnpm --filter @shiftora/api seed",
    "db:migrate": "turbo run build --filter=@shiftora/db && pnpm --filter @shiftora/db migrate",
    "test:e2e": "turbo run test:e2e",
    "check:ui-coverage": "node scripts/check-ui-coverage.mjs",
    "test:scripts": "node --test scripts/check-ui-coverage.test.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "turbo": "^2.11.10"
  }
}
